<?xml version="1.0" encoding="utf-8"?>
<!-- ويدجت Vigoris (4×2): رأس + حلقتا تقدّم + زرّان كبسوليان. ملف العربية -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp"
    android:background="@drawable/widget_bg" android:layoutDirection="rtl" android:gravity="center_vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_title" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
        <LinearLayout android:id="@+id/w_streak_pill" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="8dp" android:paddingStart="7dp" android:paddingEnd="8dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_pill">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_w_flame" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="0" android:textColor="#FDBA74" android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A5F3FC" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="62dp" android:layout_height="62dp" android:layout_marginEnd="10dp">
            <ProgressBar android:id="@+id/w_ring_train" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="false" android:max="100" android:progress="0"
                android:progressDrawable="@drawable/widget_ring_train"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/ic_w_check_i" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_w_check" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/w_sessions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:textDirection="ltr"/>
                <TextView android:id="@+id/w_sessions_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A5F3FC" android:textSize="9sp"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="62dp" android:layout_height="62dp" android:layout_marginEnd="10dp">
            <ProgressBar android:id="@+id/w_ring_water" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:indeterminate="false" android:max="100" android:progress="0"
                android:progressDrawable="@drawable/widget_ring_water"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <ImageView android:id="@+id/ic_w_drop_i" android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_w_drop" android:importantForAccessibility="no"/>
                <TextView android:id="@+id/w_water" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:textDirection="ltr"/>
                <TextView android:id="@+id/w_water_lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A5F3FC" android:textSize="9sp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_go" android:layout_width="match_parent" android:layout_height="34dp" android:background="@drawable/widget_btn"
                android:gravity="center" android:text="@string/w_go" android:textColor="#032736" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/w_add_water" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="8dp" android:background="@drawable/widget_btn_alt"
                android:gravity="center" android:text="@string/w_add_water" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
